API_PORT=8082

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=organization
MYSQL_USER=organization
MYSQL_PASSWORD=organization
MYSQL_PORT=3308

MOCKSERVER_PORT=1082

INTERNAL_TOKEN=pulse-pass-internal-token

# External dependency URLs. service-start.sh picks one of the pair according to the mode
# (test or development) and exports it as <NAME>_URL for docker compose. Every future external
# dependency follows the same pattern: <NAME>_TEST_URL and <NAME>_DEVELOPMENT_URL.
ASAAS_TEST_URL=http://organization-service-mockserver:1080
ASAAS_DEVELOPMENT_URL=https://api-sandbox.asaas.com/v3
